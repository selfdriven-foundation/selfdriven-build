# Binary files: no diffs, no line-ending changes
*.stl  binary
*.png  binary
*.jpg  binary
*.ttf  binary

# STEP files are text but very large: keep them out of diffs and merges
*.step -diff -merge

# Scripts and text: Unix line endings
*.py      text eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.md      text
*.json    text
*.txt     text
*.conf    text eol=lf

# To keep the big binaries in Git LFS instead: run `git lfs install`, then replace the first block with
# *.stl  filter=lfs diff=lfs merge=lfs -text
# *.step filter=lfs diff=lfs merge=lfs -text
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.jpg  filter=lfs diff=lfs merge=lfs -text
